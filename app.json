{
  "expo": {
    "name": "360 Retail",
    "slug": "360-retail-mobile",
    "version": "1.0.0",
    "scheme": "retail360",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#19D6C8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.retail360.mobile"
    },
    "android": {
      "package": "com.retail360.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#19D6C8"
      }
    },
    "extra": {
      "eas": {
        "projectId": "f4e92583-932a-4cf1-ae93-9d9e6c0f0ee9"
      }
    }
  }
}
